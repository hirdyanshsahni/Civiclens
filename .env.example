# Local demonstration settings. Copy this file to .env.
CIVICLENS_DEMO_MODE=true
CIVICLENS_SECRET_KEY=replace-with-a-long-random-secret-before-sharing
CIVICLENS_TOKEN_HOURS=24

# Seed credentials (demo mode only)
CIVICLENS_DEMO_CITIZEN_PASSWORD=CitizenDemo#2026
CIVICLENS_DEMO_ADMIN_PASSWORD=AdminDemo#2026

# Optional OpenAI-compatible vision endpoint. Leave blank for honest text-only demo mode.
CIVICLENS_AI_API_KEY=
CIVICLENS_AI_API_URL=https://api.openai.com/v1/chat/completions
CIVICLENS_AI_MODEL=gpt-5.4-mini

# This server serves the browser UI itself, so same-origin requests are the default.
CIVICLENS_ALLOWED_ORIGIN=http://127.0.0.1:8000

# Optional SMTP email receipts and report status updates.
# Email is reported as unavailable until host and from-address are configured.
CIVICLENS_SMTP_HOST=
CIVICLENS_SMTP_PORT=587
CIVICLENS_SMTP_USERNAME=
CIVICLENS_SMTP_PASSWORD=
CIVICLENS_EMAIL_FROM=
CIVICLENS_SMTP_USE_SSL=false
CIVICLENS_SMTP_STARTTLS=true

# Optional protected storage locations
# Relative paths are resolved from the project folder.
# CIVICLENS_DATA_DIR=backend/data
# CIVICLENS_DB_PATH=backend/data/civiclens.sqlite3
# CIVICLENS_UPLOAD_DIR=backend/data/uploads
